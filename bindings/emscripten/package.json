{
    "name": "@corpus-core/colibri-stateless",
    "version": "0.1.0",
    "description": "Colibri is a stateless and trustless ethereum client, which is optimized for the mobile apps or embedded devices, because it does not hols the state, but verifies on demand.",
    "main": "index.js",
    "type": "module",
    "types": "index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "browser": "./index.js",
            "node": {
                "import": "./index.node.js",
                "require": "./cjs/index.node.js"
            },
            "import": "./index.js",
            "require": "./cjs/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "test": "npm run test:node && npm run test:webpack",
        "test:node": "node --test test/rpc.test.mjs test/cjs_bridge.test.mjs test/runtime_selection.test.mjs",
        "test:node:native": "node --test test/native.test.mjs",
        "test:integration": "C4_RUN_INTEGRATION=1 node --test test/integration.test.mjs",
        "test:rpc-integration": "C4_RUN_RPC_INTEGRATION=1 node --test --test-concurrency=1 --test-timeout=3600000 test/rpc_integration.test.mjs",
        "test:ccip": "C4_RUN_INTEGRATION=1 node --test test/ens_ccip.test.mjs",
        "test:webpack": "npm run webpack:install && npm run webpack:build",
        "webpack:install": "cd test/webpack && npm install --legacy-peer-deps",
        "webpack:build": "cd test/webpack && npm run build",
        "webpack:start": "cd test/webpack && npm run start",
        "check:cors": "node scripts/check_cors.mjs",
        "benchmark": "node test/benchmark.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/corpus-core/c4.git"
    },
    "keywords": [
        "beacon",
        "ethereum",
        "client",
        "minimum",
        "stateless",
        "proof",
        "verifier"
    ],
    "author": "Simon Jentzsch <simon@corpus.io>",
    "contributors": [
        {
            "name": "Simon Jentzsch",
            "email": "simon@corpus.io"
        },
        {
            "name": "Steffen Kux",
            "email": "steffen@corpus.io"
        }
    ],
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/corpus-core/c4/issues"
    },
    "homepage": "https://github.com/corpus-core/c4#readme",
    "dependencies": {},
    "devDependencies": {
        "ethers": "^6.16.0"
    },
    "overrides": {
        "ws": "^8.21.3"
    },
    "publishConfig": {
        "access": "public"
    }
}