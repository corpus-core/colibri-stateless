{
    "compilerOptions": {
        "moduleResolution": "node",
        "lib": ["es2020", "DOM"],
        "target": "ES2020",
        "module": "ESNext",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "declaration": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true
    },
    "include": ["src/**/*.ts"]
}
