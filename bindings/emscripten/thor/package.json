{
    "name": "@corpus-core/colibri-thor",
    "version": "0.1.0",
    "description": "Tor network transport for Colibri Stateless. Routes RPC requests through Tor for enhanced privacy -- via Arti WASM in browsers, via SOCKS5 proxy in Node.js.",
    "main": "dist/index.js",
    "type": "module",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./browser": {
            "types": "./dist/browser.d.ts",
            "import": "./dist/browser.js"
        },
        "./node": {
            "types": "./dist/node.d.ts",
            "import": "./dist/node.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "bundleDependencies": [
        "tor-js"
    ],
    "scripts": {
        "build": "tsc",
        "build:arti": "bash scripts/build-arti.sh",
        "test": "node --test test/*.test.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/corpus-core/c4.git",
        "directory": "bindings/emscripten/thor"
    },
    "keywords": [
        "ethereum",
        "tor",
        "arti",
        "privacy",
        "socks5",
        "colibri",
        "stateless"
    ],
    "author": "Simon Jentzsch <simon@corpus.io>",
    "license": "MIT",
    "dependencies": {},
    "peerDependencies": {
        "@corpus-core/colibri-stateless": ">=0.1.0"
    },
    "peerDependenciesMeta": {
        "@corpus-core/colibri-stateless": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public"
    }
}
