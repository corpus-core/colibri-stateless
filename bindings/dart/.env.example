### Colibri Dart examples configuration
###
### Place a copy of this file as .env in bindings/dart and fill in values.

### Optional: override the native library path.
# COLIBRI_DART_LIBRARY=/full/path/to/libcolibri.(dylib|so|dll)

### Optional: set a prover service endpoint (single or comma-separated).
# COLIBRI_PROVER=https://your-prover.example
# COLIBRI_PROVERS=https://prover-1.example,https://prover-2.example

### Optional: set Ethereum RPC endpoints (single or comma-separated).
# COLIBRI_ETH_RPC=https://your-rpc.example
# COLIBRI_ETH_RPCS=https://rpc-1.example,https://rpc-2.example

### Optional: enable ZK sync proof bootstrap for remote prover (true/false).
# COLIBRI_ZK_PROOF=false

### Optional: checkpoint witness signer keys (hex, concatenated addresses).
# COLIBRI_CHECKPOINT_WITNESS_KEYS=0x<addr1_40hex><addr2_40hex>
