# syntax=docker/dockerfile:1

# Static PAP live demo. Build from the repository root:
#   docker build -f bindings/docker/Dockerfile.pap-demo -t colibri-pap-demo .
#   docker run --rm -p 8080:80 colibri-pap-demo
#
# The builder produces only static assets (HTML/JS), which are
# architecture-independent. Pinning it to the build platform lets buildx
# create multi-arch images without emulating the heavy WASM/C compile under
# QEMU -- only the tiny nginx final stage is resolved per target platform.
FROM --platform=$BUILDPLATFORM emscripten/emsdk:4.0.3 AS builder

# CMake normally derives the version from `git describe`, but the build context
# has no .git directory. Pass the version explicitly so CMake picks it up via
# $ENV{C4_VERSION}; defaults to the same value CMake would fall back to.
ARG C4_VERSION=0.1.0-dev

WORKDIR /src

# Build the colibri-stateless WASM bundle with the WASM embedded into a
# single JS file (SINGLE_FILE), so the demo needs no separate .wasm.
COPY CMakeLists.txt CMakePresets.json LICENSE ./
COPY src ./src
COPY libs ./libs
COPY bindings ./bindings
COPY scripts ./scripts

# `:-` guards against an empty build-arg (an empty env var would still be
# DEFINED in CMake and produce an empty version).
RUN C4_VERSION="${C4_VERSION:-0.1.0-dev}" emcmake cmake -B build \
    -DWASM=true -DWASM_EMBED=ON -DCLI=false -DTEST=false -DCURL=false \
    -DCMAKE_BUILD_TYPE=MINSIZREL -S . \
    && cmake --build build

# Lay out a flat site: index.html next to the logo, Colibri under /colibri/.
# The demo page in the repo points at the local cmake preset output; rewrite
# those two paths so they match this layout. Fail the build if the markers move.
RUN set -eu; \
    html=/src/bindings/emscripten/test/pap-demo.html; \
    grep -F "const buildBase = '../../../build/wasm/emscripten';" "$html"; \
    grep -F 'src="../c4_logo.png"' "$html"; \
    mkdir -p /out/colibri; \
    cp -a /src/build/emscripten/. /out/colibri/; \
    cp /src/bindings/emscripten/c4_logo.png /out/c4_logo.png; \
    sed \
    -e "s|const buildBase = '../../../build/wasm/emscripten';|const buildBase = './colibri';|" \
    -e 's|src="../c4_logo.png"|src="./c4_logo.png"|' \
    "$html" > /out/index.html

# --- Final stage: serve the static site with nginx ---
FROM nginx:alpine AS final

COPY --from=builder /out /usr/share/nginx/html

LABEL org.opencontainers.image.title="Colibri PAP Live Demo"
LABEL org.opencontainers.image.description="Browser demo of Pragmatic Adaptive Privacy for Ethereum JSON-RPC"
LABEL org.opencontainers.image.url="https://github.com/corpus-core/colibri-stateless"
LABEL org.opencontainers.image.source="https://github.com/corpus-core/colibri-stateless"
LABEL org.opencontainers.image.documentation="https://corpus-core.gitbook.io/specification-colibri-stateless"
LABEL org.opencontainers.image.vendor="Corpus Core"
LABEL org.opencontainers.image.licenses="MIT"

EXPOSE 80
