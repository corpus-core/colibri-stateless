# Multi-stage Dockerfile for the Colibri Verifier CLI.
# Builds only the verifier binary (no HTTP server, no Rust toolchain required).

FROM debian:bookworm-slim AS builder

# Build dependencies. Note: no Rust is required because HTTP_SERVER, CHAIN_OP
# and ETH_ZKPROOF_BUILD_HOST are disabled (those are the components that pull
# in the Kona-P2P bridge and the SP1 ZK proof host).
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    clang \
    git \
    build-essential \
    ca-certificates \
    libcurl4-openssl-dev \
    pkg-config \
    libssl-dev \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY CMakeLists.txt ./
COPY CMakePresets.json ./
COPY src ./src
COPY libs ./libs
COPY bindings ./bindings
COPY scripts ./scripts

# Use GCC: Bookworm's clang-14 chokes on evmone's consteval calls in
# baseline_execution.cpp; gcc-12 from build-essential compiles them fine.
ENV CC=gcc
ENV CXX=g++

# CMake normally derives the version from `git describe`, but the build context
# has no .git directory. Pass the version explicitly so CMake picks it up via
# $ENV{C4_VERSION}; defaults to the same value CMake would fall back to.
# `:-` guards against an empty build-arg (an empty env var would still be
# DEFINED in CMake and produce an empty version).
ARG C4_VERSION=0.1.0-dev

# Configure and build only the verifier CLI.
# - HTTP_SERVER=OFF avoids libuv/llhttp and disables the Rust ZK proof host
# - CHAIN_OP=OFF skips the OP-Stack Kona bridge (also Rust)
# - ETH_ZKPROOF=ON keeps ZK proof verification (the `-z` flag on the CLI)
RUN C4_VERSION="${C4_VERSION:-0.1.0-dev}" cmake \
    -DCMAKE_BUILD_TYPE=Release \
    -DHTTP_SERVER=OFF \
    -DCHAIN_OP=OFF \
    -DCHAIN_ETH=ON \
    -DETH_ZKPROOF=ON \
    -DETH_ZKPROOF_BUILD_HOST=OFF \
    -DCLI=ON \
    -DVERIFIER=ON \
    -DPROVER=ON \
    -DCURL=ON \
    . \
    && make -j"$(nproc)" colibri-verifier

# Minimal runtime image: only ship the verifier binary plus its runtime deps.
FROM debian:bookworm-slim AS final

RUN apt-get update && apt-get install -y --no-install-recommends \
    libcurl4 \
    ca-certificates \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /build/bin/colibri-verifier /app/colibri-verifier

# Allow invoking `colibri-verifier` directly without an absolute path.
ENV PATH="/app:${PATH}"

# ARG is per-stage; redeclare so the image version label matches the binary.
ARG C4_VERSION=0.1.0-dev

LABEL org.opencontainers.image.title="Colibri Verifier"
LABEL org.opencontainers.image.description="Ultra-light verifier CLI for proofs generated by the Colibri Prover (Ethereum + L2)"
LABEL org.opencontainers.image.version="${C4_VERSION}"
LABEL org.opencontainers.image.url="https://github.com/corpus-core/colibri-stateless"
LABEL org.opencontainers.image.source="https://github.com/corpus-core/colibri-stateless"
LABEL org.opencontainers.image.documentation="https://corpus-core.gitbook.io/specification-colibri-stateless"
LABEL org.opencontainers.image.vendor="Corpus Core"
LABEL org.opencontainers.image.licenses="MIT"

ENTRYPOINT ["/app/colibri-verifier"]
CMD ["--help"]
