#!/bin/bash
#
# build_proof - Locally build missing v5 ZK sync-committee proofs and upload them
#               into a remote prover's docker volume.
#
# Background:
#   The SP1 prover network rejected the deprecated `sp1-v5.0.0` circuit version,
#   so the server can no longer generate new period proofs. Existing clients are
#   still on v5 and need a valid `zk_proof.ssz` for the latest period(s). This
#   script bridges the gap by proving v5 locally (recursively on the existing
#   chain) and writing the artifacts back into the volume. The running server
#   then packs `zk_proof.ssz` automatically on the next finalized checkpoint
#   (see c4_build_zk_sync_proof_data in period_store_zk_ssz.c), after which the
#   signers recover.
#
# Usage:
#   scripts/build_proof [--no-upload] <chain> [period]
#
#     <chain>       mainnet | sepolia
#     [period]      optional: build only this single period (default: all missing)
#     --no-upload   build locally only, do NOT write artifacts back into the volume
#                   (useful for a first dry run; upload manually afterwards)
#
# Requirements (local machine):
#   - SSH access to the remote host (alias configured in ~/.ssh/config)
#   - A working local SP1 v5 toolchain + Docker (for local Groth16 wrapping),
#     i.e. the same setup `run_zk_proof.sh` used before the v6 migration.
#
# Notes:
#   - Proving is done WITHOUT --network (the network rejects v5). Local Groth16
#     wrapping requires Docker and can take ~1h per period.
#   - Recursion is mandatory: each period proof must chain onto the previous
#     period's proof so the aggregated current_keys_root still matches the
#     hardcoded trust anchor (zk_sync_keys_root) baked into existing clients.
#
set -euo pipefail

# --- Configuration ---------------------------------------------------------

# Allow overriding the docker invocation (e.g. "sudo docker"); default plain.
DOCKER_CMD="${DOCKER_CMD:-docker}"
ALPINE_IMAGE="${ALPINE_IMAGE:-alpine}"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
RUN_ZK_PROOF="$SCRIPT_DIR/run_zk_proof.sh"

# Artifacts the local prover produces and that must be uploaded to the volume.
# zk_proof_g16.bin + sync.ssz + headers.ssz(prev) are what the server uses to
# pack zk_proof.ssz; zk_proof.bin + zk_vk_raw.bin are the recursion inputs.
UPLOAD_FILES=(zk_proof_g16.bin zk_pub.bin zk_proof.bin zk_vk_raw.bin zk_groth16.bin zk_vk.bin)

# Recursion inputs required from the previous period.
PREV_FILES=(zk_proof.bin zk_vk_raw.bin)

usage() {
  cat >&2 <<EOF
Usage: scripts/build_proof [--no-upload] <chain> [period]

  <chain>       mainnet | sepolia
  [period]      optional single period to build (default: all missing)
  --no-upload   build locally only, skip writing artifacts back into the volume

Environment overrides:
  DOCKER_CMD     docker command on the remote host (default: docker)
  ALPINE_IMAGE   helper image for volume IO (default: alpine)
  OUTPUT_ROOT    local working directory (default: build/build_proof)
EOF
  exit 1
}

# --- Argument parsing ------------------------------------------------------

NO_UPLOAD=0
POSITIONAL=()
for arg in "$@"; do
  case "$arg" in
    --no-upload) NO_UPLOAD=1 ;;
    -h|--help)   usage ;;
    --*)         echo "Error: unknown option '$arg'" >&2; usage ;;
    *)           POSITIONAL+=("$arg") ;;
  esac
done

[ "${#POSITIONAL[@]}" -ge 1 ] || usage
CHAIN="${POSITIONAL[0]}"
ONLY_PERIOD="${POSITIONAL[1]:-}"

case "$CHAIN" in
  mainnet)
    SERVER="cc_mainnet1"
    VOLUME="mainnet_blocks"
    ;;
  gnosis)
    SERVER="cc_gnosis1"
    VOLUME="gnosis_blocks"
    ;;
  sepolia)
    SERVER="cc_mainnet2"
    VOLUME="sepolia_blocks"
    ;;
  *)
    echo "Error: unknown chain '$CHAIN' (expected: mainnet | sepolia)" >&2
    usage
    ;;
esac

if [ -n "$ONLY_PERIOD" ] && ! [[ "$ONLY_PERIOD" =~ ^[0-9]+$ ]]; then
  echo "Error: period must be numeric, got '$ONLY_PERIOD'" >&2
  usage
fi

OUTPUT_ROOT="${OUTPUT_ROOT:-$REPO_ROOT/build/build_proof}"
OUTPUT_DIR="$OUTPUT_ROOT/$CHAIN"
mkdir -p "$OUTPUT_DIR"

echo "=========================================================="
echo " build_proof: chain=$CHAIN server=$SERVER volume=$VOLUME"
echo " output_dir=$OUTPUT_DIR"
if [ "$NO_UPLOAD" = "1" ]; then
  echo " mode=DRY-RUN (no upload; artifacts written locally only)"
else
  echo " mode=UPLOAD (artifacts written back into the volume)"
fi
echo "=========================================================="

# --- Remote volume helpers -------------------------------------------------
# All volume access goes through a throwaway container that mounts the volume,
# because the data lives inside a docker volume on the remote host.

# Run a shell snippet inside the helper container (stdout is binary-safe).
vol_sh() {
  # $1 = shell snippet executed with `sh -c`
  ssh "$SERVER" "$DOCKER_CMD run --rm -v $VOLUME:/data $ALPINE_IMAGE sh -c '$1'"
}

# Read a file from the volume to local stdout.
vol_read() {
  # $1 = path relative to /data
  ssh "$SERVER" "$DOCKER_CMD run --rm -v $VOLUME:/data $ALPINE_IMAGE cat /data/$1"
}

# Write local stdin into a file in the volume.
vol_write() {
  # $1 = path relative to /data
  ssh "$SERVER" "$DOCKER_CMD run --rm -i -v $VOLUME:/data $ALPINE_IMAGE sh -c 'cat > /data/$1'"
}

# Create a directory in the volume.
vol_mkdir() {
  # $1 = path relative to /data
  ssh "$SERVER" "$DOCKER_CMD run --rm -v $VOLUME:/data $ALPINE_IMAGE mkdir -p /data/$1" >/dev/null
}

# Check whether a non-empty file exists in the volume (prints 1 or 0).
vol_has() {
  # $1 = path relative to /data
  vol_sh "[ -s /data/$1 ] && echo 1 || echo 0"
}

# --- Discover periods ------------------------------------------------------
# Emits "<period> <has_sync> <has_g16>" per numeric period directory.

scan_periods() {
  vol_sh 'cd /data 2>/dev/null || exit 0; for d in */; do d=${d%/}; case "$d" in *[!0-9]*) continue;; esac; s=0; g=0; [ -s "$d/sync.ssz" ] && s=1; [ -s "$d/zk_proof_g16.bin" ] && g=1; echo "$d $s $g"; done'
}

echo ">> Scanning volume for periods ..."
SCAN="$(scan_periods || true)"
if [ -z "$SCAN" ]; then
  echo "Error: could not list any period directories in volume '$VOLUME' on '$SERVER'." >&2
  echo "       Check SSH access and that the volume exists." >&2
  exit 1
fi

# Build the list of periods to process (have sync.ssz, missing zk_proof_g16.bin).
MISSING=()
while read -r period has_sync has_g16; do
  [ -n "$period" ] || continue
  if [ -n "$ONLY_PERIOD" ]; then
    [ "$period" = "$ONLY_PERIOD" ] || continue
  fi
  if [ "$has_sync" = "1" ] && [ "$has_g16" = "0" ]; then
    MISSING+=("$period")
  fi
done < <(printf '%s\n' "$SCAN" | sort -n)

if [ -n "$ONLY_PERIOD" ] && [ "${#MISSING[@]}" -eq 0 ]; then
  # Either already built or sync.ssz missing - clarify which.
  if [ "$(vol_has "$ONLY_PERIOD/zk_proof_g16.bin")" = "1" ]; then
    echo "Period $ONLY_PERIOD already has zk_proof_g16.bin - nothing to do."
    exit 0
  fi
  echo "Error: period $ONLY_PERIOD has no sync.ssz in the volume - cannot build." >&2
  exit 1
fi

if [ "${#MISSING[@]}" -eq 0 ]; then
  echo "Nothing to do: all periods with sync.ssz already have a proof."
  exit 0
fi

echo ">> Periods to build (in order): ${MISSING[*]}"

# --- Build loop ------------------------------------------------------------

fetch_prev_recursion_inputs() {
  # Ensures OUTPUT_DIR/<prev> contains the recursion inputs. Uses local copies
  # if already present (from a previous iteration in this run), otherwise pulls
  # them from the volume. Aborts if they are missing (recursion is mandatory).
  local prev="$1"
  local prev_dir="$OUTPUT_DIR/$prev"
  mkdir -p "$prev_dir"

  local f
  for f in "${PREV_FILES[@]}"; do
    if [ -s "$prev_dir/$f" ]; then
      continue
    fi
    if [ "$(vol_has "$prev/$f")" != "1" ]; then
      echo "Error: previous period $prev is missing '$f' in the volume." >&2
      echo "       Recursion is required so the proof chains to the trust anchor." >&2
      echo "       Build period $prev first (or fix the chain) before $((prev + 1))." >&2
      exit 1
    fi
    echo "   - fetching prev recursion input: $prev/$f"
    vol_read "$prev/$f" > "$prev_dir/$f"
  done
}

for PERIOD in "${MISSING[@]}"; do
  PREV=$((PERIOD - 1))
  PERIOD_DIR="$OUTPUT_DIR/$PERIOD"
  mkdir -p "$PERIOD_DIR"

  echo ""
  echo "----------------------------------------------------------"
  echo " Building proof for period $PERIOD (prev $PREV)"
  echo "----------------------------------------------------------"

  # 1. Fetch sync.ssz for the target period from the volume.
  if [ ! -s "$PERIOD_DIR/sync.ssz" ]; then
    echo ">> Fetching sync.ssz for period $PERIOD ..."
    vol_read "$PERIOD/sync.ssz" > "$PERIOD_DIR/sync.ssz"
  else
    echo ">> Using cached local sync.ssz for period $PERIOD"
  fi
  if [ ! -s "$PERIOD_DIR/sync.ssz" ]; then
    echo "Error: fetched sync.ssz for period $PERIOD is empty." >&2
    exit 1
  fi

  # 2. Ensure recursion inputs from the previous period are available locally.
  fetch_prev_recursion_inputs "$PREV"

  # 3. Run the local v5 prover (NO --network: the network rejects v5).
  echo ">> Running local proof generation for period $PERIOD (this can take ~1h) ..."
  "$RUN_ZK_PROOF" --prove --groth16 --period "$PERIOD" --output "$OUTPUT_DIR"

  # 4. Verify the expected artifacts were produced.
  for f in zk_proof_g16.bin zk_pub.bin zk_proof.bin zk_vk_raw.bin; do
    if [ ! -s "$PERIOD_DIR/$f" ]; then
      echo "Error: expected artifact '$f' was not produced for period $PERIOD." >&2
      exit 1
    fi
  done

  # 5. Upload artifacts back into the volume (unless --no-upload).
  if [ "$NO_UPLOAD" = "1" ]; then
    echo ">> DRY-RUN: skipping upload. Artifacts for period $PERIOD are in:"
    echo "   $PERIOD_DIR"
    echo "   (files: ${UPLOAD_FILES[*]})"
  else
    echo ">> Uploading artifacts for period $PERIOD into volume ..."
    vol_mkdir "$PERIOD"
    for f in "${UPLOAD_FILES[@]}"; do
      if [ -s "$PERIOD_DIR/$f" ]; then
        echo "   - uploading $f"
        vol_write "$PERIOD/$f" < "$PERIOD_DIR/$f"
      fi
    done
    echo ">> Period $PERIOD done. The server will pack zk_proof.ssz on the next checkpoint."
  fi
done

echo ""
echo "=========================================================="
if [ "$NO_UPLOAD" = "1" ]; then
  echo " All requested periods built for $CHAIN (DRY-RUN, not uploaded)."
  echo " Artifacts are under: $OUTPUT_DIR/<period>/"
  echo " Upload them manually, or re-run without --no-upload."
else
  echo " All requested periods built and uploaded for $CHAIN."
  echo " Signers should recover once zk_proof.ssz is packed."
fi
echo "=========================================================="
