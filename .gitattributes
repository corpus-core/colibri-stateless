#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
bindings/kotlin/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf
*.json          text eol=lf
# Binary files should be left untouched
*.jar           binary
*.ssz           binary

# Server HTTP mocks are stored as *.json but are binary dumps (NUL bytes,
# mixed CR). `*.json text eol=lf` above would otherwise convert them on
# checkout. `binary` is `-text -diff`; also clear leftover `eol`.
test/data/server/**             binary
test/data/server/**             -eol

